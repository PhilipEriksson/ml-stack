#!/usr/bin/env bash

set -e

ACTION=$1

show_global_help() {
  echo "🧠 ML Stack CLI"
  echo "===================="
  echo ""
  echo "Usage:"
  echo "  ml add-model auto <hf-repo> [--type base|quantized|finetuned] [--family <name>]"
  echo "  ml add-model <family> <variant> <source> [--type base|quantized|finetuned]"
  echo "  ml add-dataset <family> <hf-dataset>"
  echo "  ml process-dataset <family> <dataset>"
  echo "  ml sample-dataset <family> <dataset> <n>"
  echo "  ml create-training-run <run-name> <family/model> <family/dataset>"
  echo "  ml execute-training-run <run-name>"
  echo "  ml tensorboard          # loss curves for all runs (port 6006)"
  echo "  ml aim-ui               # run comparison UI (port 43801)"
  echo "  ml use-training-env [env-name]"
  echo "  ml kill-training"
  echo "  ml serve-model <family> <variant> [--ctx n] [--ngl n] [--port n]"
  echo "  ml set-vllm-env [env-file-name]"
  echo "  ml eval [tasks] [batch_size]"
  echo "  ml evals"
  echo "  ml compare-runs <run1> <run2>"
  echo "  ml runs"
  echo "  ml status               # registries, backends, environments, warnings"
  echo "  ml quantize <model> --format gguf|exl3|nvfp4|all"
  echo ""
  echo "Help:"
  echo "  ml help <command>"
  echo "  docs/ — full documentation (install, cli, models, serving, training,"
  echo "          quantization, evaluation, gpu-tuning, architecture)"
  echo ""
}

show_help() {
  case "$1" in
    add-model)
      echo "ml add-model"
      echo "  Downloads and registers a model from Hugging Face"
      echo "  Auto-detects type (base/gguf/quantized/finetuned), quant format (GGUF,"
      echo "  GPTQ, AWQ, AutoRound, NVFP4, MXFP4) and bit-width"
      echo "  Usage: ml add-model auto <hf-repo> [--type base|quantized|finetuned|gguf] [--family <name>]"
      echo "  Usage: ml add-model <family> <variant> <source> [--type ...] [--file <filename>] [--mmproj <file>]"
      echo "  Usage: ml add-model <family> <variant> --url <hf-file-url>"
      echo "  --family: override family detection when the repo name is ambiguous"
      echo "  --file: pick one file (required for GGUF repos with several quants)"
      echo "  --all-quants: download every file in a multi-quant GGUF repo"
      echo "  --mmproj: vision projection for multimodal GGUF models"
      ;;

    add-dataset)
      echo "ml add-dataset"
      echo "  Downloads a dataset from Hugging Face and registers it"
      echo "  Usage: ml add-dataset <family> <hf-dataset-repo>"
      ;;

    process-dataset)
      echo "ml process-dataset"
      echo "  Converts a raw dataset into alpaca format (instruction, input, output)"
      echo "  Usage: ml process-dataset <family> <dataset-name> [--instruction col --input col --output col]"
      ;;

    sample-dataset)
      echo "ml sample-dataset"
      echo "  Creates a smaller version of a processed dataset by randomly sampling N examples"
      echo "  Usage: ml sample-dataset <family> <dataset-name> <n>"
      ;;

    create-training-run)
      echo "ml create-training-run"
      echo "  Creates a new fine-tuning run configuration (Unsloth)"
      echo "  Usage: ml create-training-run <run-name> <family/model> <family/dataset> [options]"
      echo "  --method lora|qlora|fullft   training method (default: qlora)"
      echo "  --lora-r N                   adapter rank (default: 16)"
      echo "  --lora-alpha N               adapter scaling (default: same as rank)"
      echo "  --lora-dropout F             adapter dropout (default: 0)"
      echo "  --lora-targets a,b,c         target modules (default: q,k,v,o,gate,up,down)"
      echo "  --rslora                     rank-stabilized LoRA"
      ;;

    execute-training-run)
      echo "ml execute-training-run"
      echo "  Executes a training run using the active conda training environment"
      echo "  Usage: ml execute-training-run <run-name> [--sample]"
      echo "  --sample: 1 epoch, batch=8, faster logging (auto for <10K examples)"
      echo "  Use 'ml use-training-env' to switch between environments"
      ;;

    tensorboard)
      echo "ml tensorboard"
      echo "  Launches TensorBoard for all training runs (train/eval loss curves)"
      echo "  Usage: ml tensorboard"
      echo "  Serves http://localhost:6006 from outputs/runs/"
      ;;

    aim-ui)
      echo "ml aim-ui"
      echo "  Launches the Aim UI for run comparison (metrics across runs, params, diffing)"
      echo "  Usage: ml aim-ui"
      echo "  Serves http://localhost:43801 from outputs/aim/"
      ;;

    use-training-env)
      echo "ml use-training-env"
      echo "  Switch the active training conda environment"
      echo "  Usage: ml use-training-env [env-name]"
      echo "  Without args: shows the current env and the envs defined in envs/"
      ;;

    kill-training)
      echo "ml kill-training"
      echo "  Finds and kills any running finetune.py training processes"
      echo "  Usage: ml kill-training"
      ;;

    set-vllm-env)
      echo "ml set-vllm-env"
      echo "  Select the vLLM env file used by the Docker service and claude-local"
      echo "  Usage: ml set-vllm-env [env-file-name]"
      echo "  Without args: lists the env files in configs/vllm/"
      echo "  Copies the chosen file to configs/vllm/active.env (gitignored)"
      ;;

    serve-model)
      echo "ml serve-model"
      echo "  Serves a registered GGUF model via llama.cpp"
      echo "  Usage: ml serve-model <family> <variant> [--ctx n] [--ngl n] [--port n] [--host addr] [--file name] [--threads n] [--fa]"
      echo "  --file: pick one .gguf when the model directory holds several"
      echo "  For HF models, use the Docker vLLM service instead"
      ;;

    compare-runs)
      echo "ml compare-runs"
      echo "  Compares two training runs (model, dataset, hash, status)"
      echo "  Usage: ml compare-runs <run1> <run2>"
      ;;

    quantize)
      echo "ml quantize"
      echo "  Quantizes a model to GGUF, EXL3 or NVFP4 (HF repo id or local directory)"
      echo "  Usage: ml quantize <model> --format gguf  --quants Q4_K_M,Q8_0"
      echo "         ml quantize <model> --format exl3  --bpw 4.0,3.0"
      echo "         ml quantize <model> --format nvfp4 --calib <dataset-or-jsonl> --samples 256"
      echo "         ml quantize <model> --format all   --dry-run"
      echo "  Each format runs in its own conda env; see docs/quantization.md"
      ;;

    eval)
      echo "ml eval"
      echo "  Runs lm-eval benchmarks against your active inference backend"
      echo "  Usage: ml eval [tasks] [batch_size]"
      echo "  Defaults: tasks=mmlu,gsm8k,hellaswag,arc_challenge, batch_size=4"
      echo "  Results are saved to outputs/evals/ and tracked in configs/evals/registry.json"
      echo ""
      echo "  First: pip install 'lm-eval[multitask]'"
      echo "  Then:  ml eval"
      echo "         ml eval mmlu,gsm8k"
      echo "         ml eval mmlu,ifeval 8"
      ;;

    evals)
      echo "ml evals"
      echo "  Lists all recorded benchmark results from the eval registry"
      echo "  Usage: ml evals [model-slug]"
      echo "  Shows: model, timestamp, tasks, scores, result file path"
      echo "  Registry: configs/evals/registry.json"
      ;;

    runs)
      echo "ml runs"
      echo "  Lists all recorded training runs with model, dataset, status, and timestamp"
      ;;

    status)
      echo "ml status"
      echo "  One-screen overview: active environments, registered models/datasets/runs,"
      echo "  running backends, and anything missing"
      echo "  Usage: ml status"
      ;;

    *)
      echo "Unknown command: $1"
      echo ""
      show_global_help
      ;;
  esac
}

# =========================
# ENTRY LOGIC
# =========================

if [ -z "$ACTION" ]; then
  show_global_help
  exit 0
fi

if [ "$ACTION" == "help" ]; then
  if [ -z "$2" ]; then
    show_global_help
  else
    show_help "$2"
  fi
  exit 0
fi

shift

bash "${ML_STACK_HOME:-$HOME/ml-stack}/engine/runner.sh" "$ACTION" "$@"
