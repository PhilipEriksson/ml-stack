# vLLM service configuration — template
#
# Copy this file, edit MODEL_NAME and the flags that matter for your model,
# then select it:
#
#   cp configs/vllm/example.env configs/vllm/my-model.env
#   ml set-vllm-env my-model.env
#   docker compose -f services/docker/docker-compose.yml up -d vllm
#
# Every variable is optional except MODEL_NAME. services/vllm/start.sh maps
# each one to a `vllm serve` flag; unset variables are simply omitted.
#
# MODEL_NAME accepts an HF repo id (resolved through the HF cache) or a path
# inside the container (/opt/models/... — the host models/ dir is mounted there).

MODEL_NAME=<hf-repo-id-or-container-path>

# Context window and memory
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=4

# Attention / KV cache
# ATTENTION_BACKEND=flashinfer
# KV_CACHE_DTYPE=fp8_e4m3

# Quantization: usually auto-detected from the checkpoint's quantization_config.
# Set it only when the checkpoint needs an explicit hint (e.g. auto_round).
# QUANTIZATION=auto_round

# Reasoning / tool calling — parser names are model-family specific.
# REASONING_PARSER=<parser-name>
# TOOL_CALL_PARSER=<parser-name>
# ENABLE_AUTO_TOOL_CHOICE=true

# Throughput
# ENABLE_PREFIX_CACHING=true
# ENABLE_CHUNKED_PREFILL=true
# PERFORMANCE_MODE=interactivity

# Speculative decoding (JSON). Method and token count depend on the checkpoint.
# SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}

# Multimodal
# LANGUAGE_MODEL_ONLY=true
# SKIP_MM_PROFILING=true

# Bind address inside the container
HOST=0.0.0.0
PORT=8000
