{
  "_comment": "Reference config for a verifier-reward (RLVR) run. Copy to configs/training/<project>.json and adjust — local copies are gitignored, this example is the tracked reference.",
  "project": "<project-name>",
  "base_model": "<hf-repo-id-or-local-path>",
  "dtype": "bfloat16",
  "task": "<verifier-task-name>",
  "dataset": {
    "train": "datasets/processed/<family>/<dataset>/train.jsonl",
    "eval": "datasets/processed/<family>/<dataset>/eval.jsonl",
    "columns": ["prompt", "answer", "solution"]
  },
  "verifier": {
    "module": "scripts/train/verifier.py",
    "format_reward": 0.2,
    "accuracy_reward": 1.0,
    "target_pass_rate_band": [0.10, 0.30]
  },
  "sft": {
    "epochs": 2.0,
    "learning_rate": 6e-5,
    "per_device_train_batch_size": 8,
    "gradient_accumulation_steps": 4
  },
  "grpo": {
    "steps": 100,
    "num_generations": 8,
    "learning_rate": 1e-6,
    "beta": 0.0,
    "max_completion_length": 512,
    "vllm_mode": "colocate",
    "vllm_gpu_memory_utilization": 0.25
  },
  "hardware": {
    "gpu": "<gpu-model-and-vram>",
    "prereq": "stop any other GPU server before the GRPO stage"
  }
}
