#!/usr/bin/env bash

set -e

ROOT="${ML_STACK_HOME:-$HOME/ml-stack}"
REGISTRY="$ROOT/configs/models/registry.json"

# =========================
# USAGE
# =========================
# Modes:
#   add-model auto <hf-repo> [--type base|quantized|finetuned|gguf] [--family <name>]
#   add-model <family> <variant> <source> [--type ...] [--file <filename>] [--mmproj <file>]
#   add-model <family> <variant> --url <hf-file-url>
#
# Auto-detects quant format and bit-width from HF repo name/files.
# --type overrides type detection; --family overrides family detection.
# --file downloads only a specific file from the repo (required when a GGUF repo
# ships several quantizations; --all-quants takes them all).
# --mmproj records a vision projection for multimodal GGUF models.
#
# Examples:
#   add-model auto <org>/<model>-GGUF
#   add-model auto <org>/<model>-int4-AutoRound
#   add-model <family> <variant> <org>/<model> --type base
#   add-model <family> <variant> <org>/<model>-GGUF --file <model>-Q4_K_M.gguf
#   add-model <family> <variant> --url https://huggingface.co/<org>/<repo>/resolve/main/<file>.gguf

# =========================
# BIT-WIDTH DETECTION
# =========================
detect_bits() {
  local repo="$1"
  local files="${2:-}"
  local bits=""

  # Check repo name for patterns like int4, int8, 4bit, 8bit, etc
  for b in 4 8 6 3 2; do
    if echo "$repo" | grep -qi "int${b}\|${b}bit\|fp${b}"; then
      bits="${b}"
      break
    fi
  done

  # If a specific file name is given (--file), check it first
  if [ -n "${3:-}" ]; then
    local file_pattern="$3"
    for b in 4 8 6 3 2; do
      if echo "$file_pattern" | grep -qi "int${b}\|${b}bit\|fp${b}"; then
        bits="${b}"; break
      fi
    done
    if [ -z "$bits" ]; then
      if echo "$file_pattern" | grep -qiE "Q3_|IQ3"; then bits="3"
      elif echo "$file_pattern" | grep -qiE "Q4_|IQ4"; then bits="4"
      elif echo "$file_pattern" | grep -qiE "Q5_|IQ5"; then bits="5"
      elif echo "$file_pattern" | grep -qiE "Q6_|IQ6"; then bits="6"
      elif echo "$file_pattern" | grep -qiE "Q8_|IQ8"; then bits="8"
      elif echo "$file_pattern" | grep -qiE "IQ2_"; then bits="2"
      fi
    fi
  fi

  # If not found in repo name, check file names
  if [ -z "$bits" ] && [ -n "$files" ]; then
    for b in 4 8 6 3 2; do
      if echo "$files" | grep -qi "int${b}\|${b}bit\|fp${b}"; then
        bits="${b}"; break
      fi
    done
    # GGUF quant names: Q3_K, Q4_K, Q5_K, Q6_K, Q8_0, IQ2_XXS
    if [ -z "$bits" ]; then
      if echo "$files" | grep -qiE "Q3_|IQ3"; then bits="3"
      elif echo "$files" | grep -qiE "Q4_|IQ4"; then bits="4"
      elif echo "$files" | grep -qiE "Q5_|IQ5"; then bits="5"
      elif echo "$files" | grep -qiE "Q6_|IQ6"; then bits="6"
      elif echo "$files" | grep -qiE "Q8_|IQ8"; then bits="8"
      elif echo "$files" | grep -qiE "IQ2_"; then bits="2"
      fi
    fi
  fi

  # Default to 4 if nothing found
  echo "${bits:-4}"
}

# =========================
# FAMILY DETECTION
# =========================
# Families are just directory groupings under models/. Detection is a keyword
# match on the repo name; anything unrecognised needs --family.
detect_family() {
  local name="$1"
  local lower
  lower=$(echo "$name" | tr '[:upper:]' '[:lower:]')

  case "$lower" in
    *qwen*)      echo "qwen" ;;
    *llama*)     echo "llama" ;;
    *mistral*)   echo "mistral" ;;
    *mixtral*)   echo "mixtral" ;;
    *gemma*)     echo "gemma" ;;
    *phi-*)      echo "phi" ;;
    *deepseek*)  echo "deepseek" ;;
    *glm*)       echo "glm" ;;
    *granite*)   echo "granite" ;;
    *nemotron*)  echo "nemotron" ;;
    *olmo*)      echo "olmo" ;;
    *falcon*)    echo "falcon" ;;
    *smollm*)    echo "smollm" ;;
    *exaone*)    echo "exaone" ;;
    *kimi*)      echo "kimi" ;;
    *minimax*)   echo "minimax" ;;
    *gpt-oss*)   echo "gpt-oss" ;;
    *)           echo "" ;;
  esac
}

# =========================
# PARSE INPUT
# =========================
MODE=$1
shift || true

TYPE=""
FILE=""
URL=""
FAMILY_OVERRIDE=""
MMPROJ=""
ALL_QUANTS=false

POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)
      TYPE="$2"
      shift 2
      ;;
    --file)
      FILE="$2"
      shift 2
      ;;
    --url)
      URL="$2"
      shift 2
      ;;
    --family)
      FAMILY_OVERRIDE="$2"
      shift 2
      ;;
    --mmproj)
      MMPROJ="$2"
      shift 2
      ;;
    --all-quants)
      ALL_QUANTS=true
      shift
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

# =========================
# PARSE --url into SOURCE and FILE
# =========================
FROM_URL=false
if [ -n "$URL" ]; then
  # Parse URLs like:
  #   https://huggingface.co/<org>/<repo>/resolve/<branch>/<filename>
  if [[ "$URL" =~ ^https://huggingface\.co/([^/]+/[^/]+)/resolve/[^/]+/(.+)$ ]]; then
    SOURCE="${BASH_REMATCH[1]}"
    FILE="${BASH_REMATCH[2]}"
    FROM_URL=true
  else
    echo "❌ Could not parse URL: $URL"
    echo "Expected format: https://huggingface.co/<org>/<repo>/resolve/<branch>/<filename>"
    exit 1
  fi
fi

set -- "${POSITIONAL_ARGS[@]}"

# =========================
# MODE: auto
# =========================
if [ "$MODE" == "auto" ]; then
  # --url in auto mode: SOURCE/FILE already parsed, skip positional
  if [ -z "$SOURCE" ] && [ -z "$1" ]; then
    echo "Usage: add-model auto <hf-repo> [--type base|quantized|finetuned]"
    exit 1
  fi
  [ -z "$SOURCE" ] && SOURCE="$1"
  REPO_NAME=$(basename "$SOURCE")
  LOWER=$(echo "$REPO_NAME" | tr '[:upper:]' '[:lower:]')

  # Detect family from repo name (or --family)
  if [ -n "$FAMILY_OVERRIDE" ]; then
    FAMILY=$(echo "$FAMILY_OVERRIDE" | tr '[:upper:]' '[:lower:]')
  else
    FAMILY=$(detect_family "$REPO_NAME")
  fi
  if [ -z "$FAMILY" ]; then
    echo "❌ Could not auto-detect family from $SOURCE"
    echo "   Pass it explicitly: ml add-model auto $SOURCE --family <name>"
    exit 1
  fi

  VARIANT="$LOWER"

# =========================
# MODE: manual
# =========================
else
  if [ "$FROM_URL" = true ]; then
    # SOURCE came from --url; positional args are just variant
    if [ -z "$1" ]; then
      echo "Usage: add-model <family> <variant> [--url <hf-url>]"
      exit 1
    fi
    FAMILY=$(echo "$MODE" | tr '[:upper:]' '[:lower:]')
    VARIANT=$(echo "$1" | tr '[:upper:]' '[:lower:]')
  else
    # Require variant + source (--file is optional)
    if [ -z "$1" ] || [ -z "$2" ]; then
      echo "Usage: add-model <family> <variant> <source> [--type base|quantized|finetuned] [--file <filename>]"
      exit 1
    fi
    FAMILY=$(echo "$MODE" | tr '[:upper:]' '[:lower:]')
    VARIANT=$(echo "$1" | tr '[:upper:]' '[:lower:]')
    SOURCE="$2"
  fi
  REPO_NAME=$(basename "$SOURCE")
  LOWER=$(echo "$REPO_NAME" | tr '[:upper:]' '[:lower:]')
fi

# =========================
# CHECK DEPS
# =========================
if ! command -v hf >/dev/null 2>&1; then
  echo "❌ Hugging Face CLI not found"
  echo "Install: pip install -U huggingface_hub"
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "❌ jq not found"
  exit 1
fi

# =========================
# FETCH HF FILES
# =========================
echo "🔍 Fetching file list from HF..."

FILES_JSON=$(curl -s "https://huggingface.co/api/models/$SOURCE" \
  | jq -r '.siblings[].rfilename')

if [ -z "$FILES_JSON" ]; then
  echo "❌ No files found in repo"
  exit 1
fi

# =========================
# AUTO-DETECT TYPE
# =========================
if [ -z "$TYPE" ]; then
  # Adapter repos ship adapter_config.json + adapter_model.safetensors, so the
  # adapter check has to come before the generic .safetensors check.
  if echo "$FILES_JSON" | grep -qiE "adapter_config\.json|adapter_model\.(safetensors|bin)"; then
    TYPE="finetuned"
  elif echo "$FILES_JSON" | grep -qiE "\.gguf$"; then
    TYPE="gguf"
  elif echo "$FILES_JSON" | grep -qiE "\.(bin|safetensors)$"; then
    TYPE="base"
  else
    echo "⚠️ Could not auto-detect type, defaulting to 'base'"
    echo "⚠️ Use --type base|quantized|finetuned|gguf to override"
    TYPE="base"
  fi
fi

echo "📋 Detected type: $TYPE"

# =========================
# AUTO-DETECT VARIANT (pretrained, instruct, reasoning)
# =========================
VARIANT_TYPE="pretrained"
if echo "$REPO_NAME" | grep -qiE "reasoning|thinking|r1\>|cot|chain.?of.?thought"; then
  VARIANT_TYPE="reasoning"
elif echo "$REPO_NAME" | grep -qiE "instruct|instructed|assistant|chat"; then
  VARIANT_TYPE="instruct"
fi

echo "🏷️  Detected variant: $VARIANT_TYPE"

# =========================
# SELECT QUANT FORMAT
# =========================
if [ "$TYPE" == "quantized" ] || [ "$TYPE" == "gguf" ]; then
  QUANT=""

  # Auto-detect from repo name and file names
  if echo "$FILES_JSON" | grep -qiE "\.gguf$"; then
    QUANT="gguf"
  elif echo "$LOWER" | grep -qi "auto.?round\|autoround"; then
    QUANT="auto-round"
  elif echo "$LOWER" | grep -qi "gptq"; then
    QUANT="gptq"
  elif echo "$LOWER" | grep -qi "awq"; then
    QUANT="awq"
  elif echo "$LOWER" | grep -qi "nvfp4\|nvidia-fp4\|nv-fp4"; then
    QUANT="nvfp-fp4"
  elif echo "$LOWER" | grep -qi "nvfp8\|nvidia-fp8\|nv-fp8"; then
    QUANT="nvfp-fp8"
  elif echo "$LOWER" | grep -qi "mxfp4\|mx-fp4"; then
    QUANT="mx-fp4"
  elif echo "$LOWER" | grep -qi "mxfp8\|mx-fp8"; then
    QUANT="mx-fp8"
  elif echo "$LOWER" | grep -qi "paro"; then
    QUANT="paro"
  fi

  # Detect bit-width (4, 8, 6, 3, 2)
  BITS=$(detect_bits "$LOWER" "$FILES_JSON" "${FILE:-}")
  echo "📊 Detected bit-width: ${BITS}-bit"

  # Build target path based on detected quant and bit-width
  case "$QUANT" in
    gguf)
      TARGET="$ROOT/models/quantized/$FAMILY/gguf/$VARIANT"
      ;;
    auto-round)
      TARGET="$ROOT/models/quantized/$FAMILY/auto-round/${BITS}bit/$VARIANT"
      ;;
    gptq)
      TARGET="$ROOT/models/quantized/$FAMILY/gptq/${BITS}bit/$VARIANT"
      ;;
    awq)
      TARGET="$ROOT/models/quantized/$FAMILY/awq/${BITS}bit/$VARIANT"
      ;;
    nvfp-fp4)
      TARGET="$ROOT/models/quantized/$FAMILY/nvfp/fp4/$VARIANT"
      ;;
    nvfp-fp8)
      TARGET="$ROOT/models/quantized/$FAMILY/nvfp/fp8/$VARIANT"
      ;;
    mx-fp4)
      TARGET="$ROOT/models/quantized/$FAMILY/mx/fp4/$VARIANT"
      ;;
    mx-fp8)
      TARGET="$ROOT/models/quantized/$FAMILY/mx/fp8/$VARIANT"
      ;;
    paro)
      TARGET="$ROOT/models/quantized/$FAMILY/other/$VARIANT"
      ;;
    *)
      echo "⚠️ Unknown quant format, using 'other/'"
      TARGET="$ROOT/models/quantized/$FAMILY/other/$VARIANT"
      ;;
  esac

  # GGUF is its own type — serve-model dispatches on it.
  if [ "$QUANT" == "gguf" ]; then
    TYPE="gguf"
  fi

  # A GGUF repo usually ships many quantizations. Downloading all of them is
  # tens of GB and leaves serve-model guessing which file to load, so require
  # an explicit choice unless the repo has exactly one.
  if [ "$TYPE" == "gguf" ] && [ -z "$FILE" ] && [ "$ALL_QUANTS" != true ]; then
    GGUF_FILES=$(echo "$FILES_JSON" | grep -iE "\.gguf$" || true)
    GGUF_COUNT=$(echo "$GGUF_FILES" | grep -c . || true)
    if [ "$GGUF_COUNT" -gt 1 ]; then
      echo "❌ This repo ships $GGUF_COUNT GGUF files. Pick one with --file:"
      echo "$GGUF_FILES" | sed 's/^/     /'
      echo ""
      echo "   ml add-model auto $SOURCE --file <filename>"
      echo "   (or pass --all-quants to download every file)"
      exit 1
    fi
  fi

# =========================
# BASE / FINETUNED
# =========================
elif [ "$TYPE" == "base" ]; then
  TARGET="$ROOT/models/base/$FAMILY/$VARIANT"
elif [ "$TYPE" == "finetuned" ]; then
  TARGET="$ROOT/models/finetuned/$FAMILY/$VARIANT"
else
  echo "❌ Unknown type: $TYPE (use base, quantized, finetuned, or gguf)"
  exit 1
fi

if [ "$TYPE" == "gguf" ] && [ "$QUANT" != "gguf" ]; then
  echo "❌ --type gguf but no .gguf files found in $SOURCE"
  exit 1
fi

# =========================
# STAGE IN REGISTRY (downloading)
# =========================
[ -s "$REGISTRY" ] || echo '{}' > "$REGISTRY"

TEMP=$(mktemp)
jq --arg fam "$FAMILY" \
   --arg var "$VARIANT" \
   --arg type "$TYPE" \
   --arg path "$TARGET" \
   --arg variant "$VARIANT_TYPE" \
   --arg file "$FILE" \
   --arg mmproj "$MMPROJ" \
   '
   .[$fam] = (.[$fam] // {}) |
   .[$fam].models = (.[$fam].models // {}) |
   .[$fam].models[$var] = ({
     type: $type,
     variant: $variant,
     path: $path,
     status: "downloading"
   }
   + (if $file   != "" then {file: $file}     else {} end)
   + (if $mmproj != "" then {mmproj: $mmproj} else {} end))
   ' "$REGISTRY" > "$TEMP" && mv "$TEMP" "$REGISTRY"

# =========================
# DOWNLOAD
# =========================
mkdir -p "$TARGET"

echo "📦 Target: $TARGET"
echo "⬇️ Downloading${FILE:+ $FILE}..."

if [ -n "$FILE" ]; then
  if ! hf download "$SOURCE" "$FILE" --local-dir "$TARGET"; then
    TEMP=$(mktemp)
    jq --arg fam "$FAMILY" \
       --arg var "$VARIANT" \
       '.[$fam].models[$var].status = "error"' "$REGISTRY" > "$TEMP" && mv "$TEMP" "$REGISTRY"
    echo "❌ Download failed — registry status set to 'error'"
    exit 1
  fi
else
  if ! hf download "$SOURCE" --local-dir "$TARGET"; then
    TEMP=$(mktemp)
    jq --arg fam "$FAMILY" \
       --arg var "$VARIANT" \
       '.[$fam].models[$var].status = "error"' "$REGISTRY" > "$TEMP" && mv "$TEMP" "$REGISTRY"
    echo "❌ Download failed — registry status set to 'error'"
    exit 1
  fi
fi

# Detect what was actually downloaded
DOWNLOADED=$(find "$TARGET" -maxdepth 1 -type f \( -name "*.gguf" -o -name "*.safetensors" -o -name "*.bin" \) | head -n 1)

if [ -z "$DOWNLOADED" ]; then
  DOWNLOADED="$TARGET"
fi

# Resolve a relative --mmproj against the download target
if [ -n "$MMPROJ" ] && [[ "$MMPROJ" != /* ]]; then
  MMPROJ="$TARGET/$MMPROJ"
fi

echo "✅ Downloaded to: $TARGET"

# =========================
# COMPUTE HASH
# =========================
# Exclude hf's download metadata (.cache/) and dotfiles: they change between
# downloads of identical weights and would make the hash unstable.
MODEL_HASH=$(find "$TARGET" -type f \
  -not -path "*/.cache/*" \
  -not -name ".*" \
  -print0 \
  | sort -z \
  | xargs -0 sha256sum \
  | sha256sum \
  | awk '{print $1}')

# =========================
# COMMIT TO REGISTRY (ready)
# =========================
TEMP=$(mktemp)

jq --arg fam "$FAMILY" \
   --arg var "$VARIANT" \
   --arg type "$TYPE" \
   --arg path "$TARGET" \
   --arg variant "$VARIANT_TYPE" \
   --arg hash "$MODEL_HASH" \
   --arg file "$FILE" \
   --arg mmproj "$MMPROJ" \
   '
   .[$fam] = (.[$fam] // {}) |
   .[$fam].models = (.[$fam].models // {}) |
   .[$fam].models[$var] = ({
     type: $type,
     variant: $variant,
     path: $path,
     hash: $hash,
     status: "ready"
   }
   + (if $file   != "" then {file: $file}     else {} end)
   + (if $mmproj != "" then {mmproj: $mmproj} else {} end))
   ' "$REGISTRY" > "$TEMP" && mv "$TEMP" "$REGISTRY"

echo "✅ Added to registry: $FAMILY/$VARIANT"
echo "🔐 Hash: $MODEL_HASH"
if [ "$TYPE" == "gguf" ]; then
  echo "📊 Use: ml serve-model $FAMILY $VARIANT"
else
  echo "📊 Use: point configs/vllm/active.env at $TARGET, then start the vllm service"
fi
