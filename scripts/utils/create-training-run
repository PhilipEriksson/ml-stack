#!/usr/bin/env bash

ROOT="${ML_STACK_HOME:-$HOME/ml-stack}"

set -e

REGISTRY="$ROOT/configs/runs/registry.json"
MODEL_REG="$ROOT/configs/models/registry.json"
DATASET_REG="$ROOT/configs/datasets/registry.json"

# =========================
# INPUT
# =========================
if [ -z "$1" ] || [ -z "$2" ]; then
  echo "Usage:"
  echo "  create-training-run <run-name> <family/model> <family/dataset> [options]"
  echo ""
  echo "  model and dataset must include their family prefix:"
  echo "    ml create-training-run <run-name> <family>/<model> <family>/<dataset>"
  echo ""
  echo "  Options:"
  echo "    --method lora|qlora|fullft   training method (default: qlora)"
  echo "    --lora-r N                   adapter rank (default: 16)"
  echo "    --lora-alpha N               adapter scaling (default: same as rank)"
  echo "    --lora-dropout F             adapter dropout (default: 0)"
  echo "    --lora-targets a,b,c         target modules (default: q,k,v,o,gate,up,down)"
  echo "    --rslora                     rank-stabilized LoRA"
  exit 1
fi

RUN=$1
MODEL_REF=$2
DATASET_REF=$3

# Parse optional --method flag (default: qlora) and LoRA adapter knobs
METHOD="qlora"
LORA_R=""
LORA_ALPHA=""
LORA_DROPOUT=""
LORA_TARGETS=""
LORA_RSLORA=""
shift 3 || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --method)
      METHOD="$2"
      shift 2
      ;;
    --lora-r)
      LORA_R="$2"
      shift 2
      ;;
    --lora-alpha)
      LORA_ALPHA="$2"
      shift 2
      ;;
    --lora-dropout)
      LORA_DROPOUT="$2"
      shift 2
      ;;
    --lora-targets)
      LORA_TARGETS="$2"
      shift 2
      ;;
    --rslora)
      LORA_RSLORA="true"
      shift
      ;;
    *)
      echo "❌ Unknown option: $1"
      exit 1
      ;;
  esac
done

for pair in "lora-r:$LORA_R" "lora-alpha:$LORA_ALPHA"; do
  name="${pair%%:*}"
  val="${pair#*:}"
  if [ -n "$val" ] && ! [[ "$val" =~ ^[0-9]+$ ]]; then
    echo "❌ --$name must be a positive integer (got: $val)"
    exit 1
  fi
done
if [ -n "$LORA_DROPOUT" ] && ! [[ "$LORA_DROPOUT" =~ ^[0-9]*\.?[0-9]+$ ]]; then
  echo "❌ --lora-dropout must be a number between 0 and 1 (got: $LORA_DROPOUT)"
  exit 1
fi

case "$METHOD" in
  lora|qlora|fullft) ;;
  *)
    echo "❌ Invalid --method: $METHOD (expected lora | qlora | fullft)"
    exit 1
    ;;
esac

# Parse family/variant from references
MODEL_FAM=$(echo "$MODEL_REF" | cut -d/ -f1)
MODEL_VAR=$(echo "$MODEL_REF" | cut -d/ -f2)
DATA_FAM=$(echo "$DATASET_REF" | cut -d/ -f1)
DATA_VAR=$(echo "$DATASET_REF" | cut -d/ -f2)

if [ "$MODEL_FAM" = "$MODEL_VAR" ] || [ -z "$MODEL_VAR" ]; then
  echo "❌ Model reference must be in family/variant format (e.g. <family>/<model>)"
  echo "   Use: ml create-training-run <run-name> <family/model> <family/dataset>"
  exit 1
fi

if [ "$DATA_FAM" = "$DATA_VAR" ] || [ -z "$DATA_VAR" ]; then
  echo "❌ Dataset reference must be in family/variant format (e.g. <family>/<dataset>)"
  echo "   Use: ml create-training-run <run-name> <family/model> <family/dataset>"
  exit 1
fi

RUNS_DIR="$ROOT/outputs/runs"
RUN_DIR="$RUNS_DIR/$RUN"

mkdir -p "$RUN_DIR"/{model,dataset,logs,artifacts}

# =========================
# TIMESTAMP
# =========================
TIME=$(date +%Y-%m-%d_%H-%M-%S)

# =========================
# RESOLVE MODEL (precise family-based lookup)
# =========================
MODEL_PATH=$(jq -r --arg f "$MODEL_FAM" --arg m "$MODEL_VAR" '.[$f].models[$m].path // empty' "$MODEL_REG")
MODEL_HASH=$(jq -r --arg f "$MODEL_FAM" --arg m "$MODEL_VAR" '.[$f].models[$m].hash // empty' "$MODEL_REG")
MODEL_TYPE=$(jq -r --arg f "$MODEL_FAM" --arg m "$MODEL_VAR" '.[$f].models[$m].type // empty' "$MODEL_REG")
MODEL_VARIANT=$(jq -r --arg f "$MODEL_FAM" --arg m "$MODEL_VAR" '.[$f].models[$m].variant // "pretrained"' "$MODEL_REG")

if [ -z "$MODEL_PATH" ]; then
  echo "❌ Model not found in registry: $MODEL_FAM/$MODEL_VAR"
  echo "   Use: ml add-model $MODEL_FAM $MODEL_VAR <hf-repo>"
  exit 1
fi

# Warn if model type isn't suitable for fine-tuning
if [ "$MODEL_TYPE" == "gguf" ]; then
  echo "⚠️  GGUF models cannot be fine-tuned with Unsloth"
  echo "⚠️  Download a base model first: ml add-model auto <hf-repo> --type base"
  echo "⚠️  Continuing anyway — the training script may fail."
fi

# =========================
# RESOLVE DATASET (precise family-based lookup)
# =========================
PROCESSED_PATH=$(jq -r --arg f "$DATA_FAM" --arg d "$DATA_VAR" '.[$f].datasets[$d].processed_path // empty' "$DATASET_REG")
RAW_PATH=$(jq -r --arg f "$DATA_FAM" --arg d "$DATA_VAR" '.[$f].datasets[$d].local_path // empty' "$DATASET_REG")

if [ -z "$RAW_PATH" ]; then
  echo "❌ Dataset not found in registry: $DATA_FAM/$DATA_VAR"
  echo "   Use: ml add-dataset $DATA_FAM <hf-dataset>"
  exit 1
fi

# Prefer processed dataset, fall back to raw with warning
if [ -n "$PROCESSED_PATH" ]; then
  DATASET_PATH="$PROCESSED_PATH"
else
  echo ""
  echo "⚠️  Dataset is not processed yet. The training script expects alpaca"
  echo "   format (instruction, input, output) with train/ and eval/ subdirs."
  echo "   Process it first: ml process-dataset $DATA_FAM $DATA_VAR"
  echo "   Falling back to raw path — training may fail."
  DATASET_PATH="$RAW_PATH"
fi

# =========================
# SAVE METADATA
# =========================
echo "$MODEL_PATH" > "$RUN_DIR/model/path.txt"
echo "$MODEL_HASH" > "$RUN_DIR/model/hash.txt"
echo "$DATASET_PATH" > "$RUN_DIR/dataset/path.txt"

# =========================
# WRITE CONFIG
# =========================
cat <<EOF > "$RUN_DIR/config.json"
{
  "run": "$RUN",
  "model": "$MODEL_REF",
  "model_path": "$MODEL_PATH",
  "model_type": "$MODEL_TYPE",
  "model_variant": "$MODEL_VARIANT",
  "model_hash": "$MODEL_HASH",
  "dataset": "$DATASET_REF",
  "dataset_path": "$DATASET_PATH",
  "method": "$METHOD",
  "timestamp": "$TIME"
}
EOF

# Merge any LoRA adapter knobs into the run config (only the ones passed)
if [ -n "$LORA_R$LORA_ALPHA$LORA_DROPOUT$LORA_TARGETS$LORA_RSLORA" ]; then
  TMPC=$(mktemp)
  jq --arg r "$LORA_R" --arg a "$LORA_ALPHA" --arg d "$LORA_DROPOUT" \
     --arg t "$LORA_TARGETS" --arg rs "$LORA_RSLORA" '
    (if $r  != "" then .lora_r = ($r|tonumber) else . end)
    | (if $a != "" then .lora_alpha = ($a|tonumber) else . end)
    | (if $d != "" then .lora_dropout = ($d|tonumber) else . end)
    | (if $t != "" then .lora_target_modules = ($t|split(",")) else . end)
    | (if $rs != "" then .lora_rslora = true else . end)
  ' "$RUN_DIR/config.json" > "$TMPC" && mv "$TMPC" "$RUN_DIR/config.json"
fi

# =========================
# REGISTER RUN
# =========================
[ -s "$REGISTRY" ] || echo '{}' > "$REGISTRY"

TMP=$(mktemp)

jq --arg run "$RUN" \
   --arg model "$MODEL_REF" \
   --arg hash "$MODEL_HASH" \
   --arg variant "$MODEL_VARIANT" \
   --arg dataset "$DATASET_REF" \
   --arg path "$RUN_DIR" \
   --arg time "$TIME" \
   --arg method "$METHOD" '
.[$run] = {
  model: $model,
  model_hash: $hash,
  model_variant: $variant,
  dataset: $dataset,
  path: $path,
  method: $method,
  timestamp: $time,
  status: "created"
}
' "$REGISTRY" > "$TMP" && mv "$TMP" "$REGISTRY"

# =========================
# DONE
# =========================
echo "✅ Training run created"
echo "📦 Run: $RUN"
echo "🤖 Model: $MODEL_REF ($MODEL_TYPE)"
echo "🧠 Method: $METHOD"
echo "🔐 Model hash: $MODEL_HASH"
echo "📊 Dataset: $DATASET_REF"
echo "📁 Path: $RUN_DIR"
echo ""
echo "Next: ml execute-training-run $RUN"