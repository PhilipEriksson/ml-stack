#!/usr/bin/env bash
# Select the vLLM env file used by the Docker service and claude-local.
#
# Usage:
#   ml set-vllm-env                 # list available env files
#   ml set-vllm-env <env-file-name> # copy it to configs/vllm/active.env
#
# configs/vllm/active.env is gitignored local state; docker-compose.yml and
# get-claude-env both read it, so switching models is one command.

set -e
ROOT="${ML_STACK_HOME:-$HOME/ml-stack}"
ENV_DIR="$ROOT/configs/vllm"
ACTIVE="$ENV_DIR/active.env"

if [ -z "$1" ]; then
  echo "Available vLLM env files in $ENV_DIR:"
  for f in "$ENV_DIR"/*.env; do
    [ -f "$f" ] || continue
    [ "$(basename "$f")" = "active.env" ] && continue
    MODEL=$(grep '^MODEL_NAME=' "$f" | head -1 | cut -d= -f2-)
    printf '  %-28s %s\n' "$(basename "$f")" "${MODEL:-<no MODEL_NAME>}"
  done
  echo ""
  if [ -f "$ACTIVE" ]; then
    echo "Active: $(grep '^MODEL_NAME=' "$ACTIVE" | head -1 | cut -d= -f2-)"
  else
    echo "Active: none (copy configs/vllm/example.env and edit it)"
  fi
  exit 0
fi

ENV_NAME="$1"
if [ ! -f "$ENV_DIR/$ENV_NAME" ]; then
  echo "❌ env file not found: $ENV_DIR/$ENV_NAME"
  echo "   Run 'ml set-vllm-env' to list the available files."
  exit 1
fi

cp "$ENV_DIR/$ENV_NAME" "$ACTIVE"
echo "✅ Active vLLM env: $ENV_NAME"
MODEL_NAME=$(grep '^MODEL_NAME=' "$ACTIVE" | head -1 | cut -d= -f2-)
echo "   Model: ${MODEL_NAME:-<unset>}"
echo "   Run: docker compose -f services/docker/docker-compose.yml up -d vllm"
echo "   Then: claude-local"
