#!/usr/bin/env bash

set -e

ROOT="${ML_STACK_HOME:-$HOME/ml-stack}"
CONFIG="$ROOT/configs/.active-training-env"

if [ -z "$1" ]; then
  echo "Usage: use-training-env <env-name>"
  echo ""
  echo "  Sets the active training conda environment. Training scripts and"
  echo "  'ml quantize --format gguf' resolve their interpreter from it."
  echo ""
  echo "  Environments defined in envs/:"
  for f in "$ROOT"/envs/*.yml; do
    [ -f "$f" ] || continue
    name=$(grep '^name:' "$f" | awk '{print $2}')
    printf '    %-16s (%s)\n' "${name:-$(basename "$f" .yml)}" "$(basename "$f")"
  done
  echo ""
  echo "  Current: $(cat "$CONFIG" 2>/dev/null || echo 'training (default)')"
  exit 0
fi

# Verify the conda environment exists
FOUND=false
for CONDA_ROOT in "$HOME/miniconda" "$HOME/anaconda3" "$HOME/conda"; do
  if [ -d "$CONDA_ROOT/envs/$1" ]; then
    FOUND=true
    break
  fi
done

if [ "$FOUND" = false ]; then
  echo "❌ Conda environment '$1' not found"
  echo "   Create it first: conda env create -f envs/<file>.yml"
  exit 1
fi

mkdir -p "$(dirname "$CONFIG")"
echo "$1" > "$CONFIG"
echo "✅ Active training environment → $1"
echo "   Training scripts and GGUF quantization will use this environment"
